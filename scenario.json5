{
  manifest_version: "0.1.0",
  experimental_features: ["docker"],
  config_schema: {
    type: "object",
    properties: {
      openai_api_key: { type: "string", secret: true },
    },
  },
  components: {
    gateway: {
      manifest: "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.3/amber-manifest.json5",
      config: {
        assessment_config: {
          tasks: ["arvo:47101", "oss-fuzz:42535201"],
          level: "level1",
          num_workers: 2,
        },
        participant_roles: {
          green: "green_agent",
          agent: "participant_agent",   // ← purple agent
        },
      },
    },
    green_agent: {
      manifest: "./green-agent.json5",
      config: {},                       
    },
    participant_agent: {
      manifest: "./participant.json5",
      config: {
        openai_api_key: "${config.openai_api_key}",
      },
    },
  },
  bindings: [
    { to: "#gateway.green",        from: "#green_agent.a2a" },
    { to: "#gateway.agent",        from: "#participant_agent.a2a" },
    { to: "#green_agent.proxy",    from: "#participant_agent.a2a" }, 
  ],
  exports: {
    results: "#gateway.results",
  },
  metadata: {
    agentbeats_ids: {
      green_agent: "019e03f3-04eb-71a0-abaf-5853afdc1418",
      participant_agent: "019e0419-2203-78c3-bc10-aa950585854c",
    },
  },
}